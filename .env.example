# ──────────────────────────────────────────────────────
# .env.example  —  copy to .env for local development
# In production (Railway / Render) set these in the
# platform dashboard.  Never commit .env to git.
# ──────────────────────────────────────────────────────

# ── DATABASE (required) ───────────────────────────────
# Single connection string — no individual DB_* vars needed.
# Local:      mysql://root:@localhost:3306/attendance_db
# Railway:    injected automatically when MySQL service is linked
# Render:     paste from your external MySQL provider (PlanetScale, Aiven, etc.)
MYSQL_URL=mysql://root:@localhost:3306/attendance_db

# ── AUTH (required) ───────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ── SERVER ────────────────────────────────────────────
# PORT is injected automatically by Railway / Render — do not set it there
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────
# Set to your deployed URL in production
CORS_ORIGIN=http://localhost:3000

# ── ATTENDANCE RULES ──────────────────────────────────
LATE_TIME=09:00
WORK_HOURS_PER_DAY=8
MAX_SESSION_HOURS=24

# ── SECURITY ──────────────────────────────────────────
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# ── RATE LIMITING ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ── GPS / GEOFENCING (all optional) ───────────────────
REQUIRE_LOCATION_FOR_CHECKIN=false
ENABLE_GEOFENCING=false
OFFICE_LATITUDE=
OFFICE_LONGITUDE=
OFFICE_RADIUS_METERS=200
GPS_MAX_ACCURACY=50

# ── LOGGING ───────────────────────────────────────────
LOG_LEVEL=info
ENABLE_AUDIT_LOG=false
