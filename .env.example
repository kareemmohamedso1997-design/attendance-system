# ======================================================
# .env.example — copy to .env and fill in real values
# NEVER commit .env to version control
# ======================================================

# ── Database ──────────────────────────────────────────
# Option A (Railway recommended): set MYSQL_URL — the app reads it automatically.
# Railway injects this when you link a MySQL service to your Node.js service.
# MYSQL_URL=mysql://user:password@host:port/database

# Option B (local / manual): individual fields
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance_db
DB_PORT=3306

# ── Server ────────────────────────────────────────────
# PORT is injected by Railway automatically — do not set it in Railway dashboard.
PORT=3000
NODE_ENV=development       # set to "production" in Railway (already in railway.toml)

# ── JWT ───────────────────────────────────────────────
# REQUIRED: Generate a strong secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ── Attendance rules ──────────────────────────────────
LATE_TIME=09:00            # HH:MM — check-ins after this time are marked late
WORK_HOURS_PER_DAY=8
MAX_SESSION_HOURS=24       # sessions longer than this are auto-closed

# ── Security ──────────────────────────────────────────
BCRYPT_ROUNDS=10           # increase to 12 for stronger hashing (slower login)
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15               # minutes before a locked account is released

# ── Rate limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ── GPS / Geofencing ──────────────────────────────────
# Require employees to share GPS on check-in/out
REQUIRE_LOCATION_FOR_CHECKIN=false

# Enforce physical proximity to office
ENABLE_GEOFENCING=false
OFFICE_LATITUDE=
OFFICE_LONGITUDE=
OFFICE_RADIUS_METERS=200

# Reject GPS fixes worse (higher metres) than this accuracy
GPS_MAX_ACCURACY=50

# ── CORS ──────────────────────────────────────────────
# Frontend and backend are on the same Railway domain — set to your Railway URL.
# Comma-separate multiple origins if needed.
# CORS_ORIGIN=https://your-app.up.railway.app
CORS_ORIGIN=http://localhost:3000

# ── Logging ───────────────────────────────────────────
# LOG_LEVEL controls minimum severity written to stdout: debug | info | warn | error
LOG_LEVEL=info

# ENABLE_AUDIT_LOG=true also writes logs to files under logs/ (optional in production;
# Railway's built-in log viewer is usually sufficient)
ENABLE_AUDIT_LOG=false
